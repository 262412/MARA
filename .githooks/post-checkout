#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
common_dir="$(git -C "$root" rev-parse --git-common-dir)"
if [[ "$common_dir" != /* && ! "$common_dir" =~ ^[A-Za-z]:[/\\] ]]; then
  common_dir="$root/$common_dir"
fi
primary_root="$(cd -- "$common_dir/.." && pwd -P)"
current_root="$(cd -- "$root" && pwd -P)"
[[ "$current_root" == "$primary_root" ]] && exit 0

guard="$primary_root/scripts/check_mara_worktree_env.py"
[[ -f "$guard" ]] || exit 0

bootstrap_python=python3
case "$(uname -s)" in
  MINGW*|MSYS*)
    bootstrap_python=python
    if [[ -x "$primary_root/.venv/Scripts/python.exe" ]]; then
      bootstrap_python="$primary_root/.venv/Scripts/python.exe"
    fi
    ;;
esac
exec "$bootstrap_python" "$guard" prepare-linked
